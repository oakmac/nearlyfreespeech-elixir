#!/bin/sh
set -e

# run.sh — NFS daemon entry point
#
# This script is what NearlyFreeSpeech runs as a daemon. It:
#   1. Exports your app's environment variables
#   2. Checks whether the build environment has changed (eg realm update)
#   3. Rebuilds if needed
#   4. exec's into the Elixir release (capturing BEAM crash diagnostics)
#
# Copy this file to /home/protected/run.sh on your server and fill in the
# real values. Do NOT commit this file to version control — it contains secrets.

# ── Application configuration ────────────────────────────────────────────────

# Edit these for your project.
export APP_NAME="myapp"
export PORT=9235
export PHX_HOST="yourdomain.com"
export SECRET_KEY_BASE="generate_with_mix_phx_gen_secret"
export DATABASE_URL="ecto://user:password@host/database"

# Add any other env vars your app needs here (API keys, SMTP credentials, etc.)

# Phoenix-specific
export MIX_ENV=prod
export PHX_SERVER=true

# ── Crash diagnostics ────────────────────────────────────────────────────────
# Capture stderr and ask ERTS to write an Erlang crash dump when it can. Some
# failures (especially an external SIGKILL) may terminate the VM without either.
# server/setup.sh creates this writable directory for the web daemon.

DIAGNOSTICS_DIR="/home/protected/diagnostics"

if [ ! -d "$DIAGNOSTICS_DIR" ] || [ ! -w "$DIAGNOSTICS_DIR" ]; then
  echo "ERROR: $DIAGNOSTICS_DIR is missing or not writable. Run the repository setup script."
  exit 1
fi

export ERL_CRASH_DUMP="${DIAGNOSTICS_DIR}/erl_crash.dump"
BEAM_STDERR_LOG="${DIAGNOSTICS_DIR}/beam-stderr.log"

# ── Validate configuration ───────────────────────────────────────────────────

if [ "$APP_NAME" = "myapp" ]; then
  echo "ERROR: APP_NAME is still set to 'myapp'. Edit run.sh with your real app name."
  exit 1
fi

if [ "$SECRET_KEY_BASE" = "generate_with_mix_phx_gen_secret" ]; then
  echo "ERROR: SECRET_KEY_BASE is still the placeholder. Run 'mix phx.gen.secret' and paste the result."
  exit 1
fi

# ── Environment check ────────────────────────────────────────────────────────

# Compare the current Elixir + ERTS versions against what the release was
# built with. If anything has changed (eg NFS realm update), rebuild from source.
# On normal restarts this check passes quickly.
#
# !! KEEP IN SYNC !! — build.sh computes the same fingerprint when it writes
# BUILD_ENV. The two format strings must be byte-identical, or every daemon
# start will trigger a spurious rebuild. If you edit the printf below, edit the
# matching one in build.sh.
#
# `elixir --short-version` is handled by the Elixir launcher without booting the
# VM. `erlang:system_info(version)` returns only the ERTS version, keeping the
# fingerprint independent of machine-specific banner details.

RELEASE_DIR="/home/protected/releases/current-release"
RELEASE_BIN="${RELEASE_DIR}/bin/${APP_NAME}"

NEEDS_BUILD=false

if [ -x "$RELEASE_BIN" ]; then
  ELIXIR_VSN=$(elixir --short-version 2>/dev/null) || ELIXIR_VSN=""
  ERTS_VSN=$(erl -noshell -eval 'io:format(erlang:system_info(version))' -s init stop 2>/dev/null) || ERTS_VSN=""

  if [ -z "$ELIXIR_VSN" ] || [ -z "$ERTS_VSN" ]; then
    echo "ERROR: Failed to detect Elixir/ERTS versions."
    exit 1
  fi

  # KEEP IN SYNC with the identical line in build.sh
  CURRENT_ENV=$(printf 'Elixir %s | erts-%s' "$ELIXIR_VSN" "$ERTS_VSN")

  BUILT_ENV=$(cat "$RELEASE_DIR/BUILD_ENV" 2>/dev/null || echo "unknown")

  if [ "$CURRENT_ENV" != "$BUILT_ENV" ]; then
    echo "Environment changed. Rebuilding..."
    echo "  was: $BUILT_ENV"
    echo "  now: $CURRENT_ENV"
    NEEDS_BUILD=true
  fi
else
  echo "No release found. Building from source..."
  NEEDS_BUILD=true
fi

if [ "$NEEDS_BUILD" = true ]; then
  if ! /home/protected/build.sh; then
    echo "ERROR: Build failed. Check the logs above. NFS will retry."
    exit 1
  fi

  # Re-check that the release binary exists after building
  if [ ! -x "$RELEASE_BIN" ]; then
    echo "ERROR: Release binary missing after build. Something went wrong."
    exit 1
  fi
fi

# stdout continues to the NFS daemon log. stderr is captured separately so
# BEAM abort messages are retained when the VM can emit them.
exec "$RELEASE_BIN" start 2>> "$BEAM_STDERR_LOG"
